# Leave blank to use the persistent local JSON fallback in data/db.json.
MONGO_URL=
MONGO_DB_NAME=css_society
# Vercel deployments require MONGO_URL; local JSON is for local development.

# Both are required for production admin access. Development without them uses local demo mode.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Recommended independent random session secret (at least 32 random bytes).
# Rotating this or ADMIN_PASSWORD invalidates existing admin sessions.
ADMIN_SESSION_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local form-file storage is development-only; production file fields require a durable adapter.
FORM_STORAGE=local
# Comma-separated exact HTTPS image hostnames permitted by the image optimizer.
IMAGE_REMOTE_HOSTS=
